# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# เซิร์ฟเวอร์เท่านั้น ห้ามใส่ NEXT_PUBLIC_ และห้าม commit
SUPABASE_SERVICE_ROLE_KEY=

# อ่านสลิปด้วย Tesseract OCR ในเบราว์เซอร์ (ฟรี) ไม่ต้องใช้ API key
# ตัวเลือกสำรอง: ให้ Claude อ่านเมื่อ OCR ฟรีอ่านวันที่/จำนวนเงินไม่ได้ (เสียค่า API)
OCR_FALLBACK_CLAUDE=false
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# (แนะนำ) ล็อกทั้งเว็บด้วย Basic Auth ถ้าตั้งทั้งสองค่า
APP_USER=
APP_PASSWORD=
